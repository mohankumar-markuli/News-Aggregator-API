{
  "name": "news-aggregator-api",
  "version": "1.0.0",
  "description": "a RESTful API for a personalized news aggregator",
  "homepage": "https://github.com/mohankumar-markuli/News-Aggregator-API#readme",
  "bugs": {
    "url": "https://github.com/mohankumar-markuli/News-Aggregator-API/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohankumar-markuli/News-Aggregator-API.git"
  },
  "license": "ISC",
  "author": "Mohankumar",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "jest ",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.1",
    "validator": "^13.15.35"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "html",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 85,
        "statements": 85
      }
    },
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/app.js",
      "!src/server.js",
      "!src/utils/**"
    ]
  }
}
